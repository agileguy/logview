{
  "$schema": "https://logview.dev/schema/config.json",
  "contexts": [
    {
      "name": "app-logs",
      "type": "logfile",
      "path": "/var/log/myapp/application.log",
      "format": "auto"
    },
    {
      "name": "api-jsonl",
      "type": "logfile",
      "path": "/var/log/api/requests.jsonl",
      "format": "jsonl"
    },
    {
      "name": "prod-gke",
      "type": "gke",
      "project": "my-gcp-project",
      "cluster": "prod-cluster",
      "location": "us-central1-a",
      "default_namespace": "default"
    },
    {
      "name": "staging-gke",
      "type": "gke",
      "project": "my-gcp-project",
      "cluster": "staging-cluster",
      "location": "us-west1-b"
    },
    {
      "name": "gcp-audit",
      "type": "gcp",
      "project": "my-gcp-project",
      "log_name": "cloudaudit.googleapis.com%2Factivity"
    },
    {
      "name": "gcp-compute",
      "type": "gcp",
      "project": "my-gcp-project",
      "resource_type": "gce_instance"
    },
    {
      "name": "local-syslog",
      "type": "syslog",
      "path": "/var/log/syslog"
    },
    {
      "name": "testing",
      "type": "mock",
      "seed": 42
    }
  ],
  "discovery": {
    "paths": ["/var/log", "/home/user/logs"],
    "max_depth": 3,
    "allowed_directories": ["/var/log", "/opt", "/home"]
  },
  "presets": [
    {
      "name": "errors-last-hour",
      "severity": "ERROR",
      "time_range_minutes": 60
    },
    {
      "name": "api-debug",
      "pod": "api-*",
      "severity": "DEBUG",
      "namespace": "default"
    }
  ],
  "ui": {
    "theme": "dark",
    "timestamp_format": "%Y-%m-%d %H:%M:%S",
    "max_message_width": 80,
    "show_metadata": false
  },
  "security": {
    "credential_helper": "gcloud"
  },
  "logging": {
    "level": "WARNING",
    "file": null,
    "max_size_mb": 10,
    "backup_count": 3
  }
}
